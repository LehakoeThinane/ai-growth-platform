<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UserSecretsId>AiGrowthPlatform.Api.Local</UserSecretsId>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Agents\AiGrowthPlatform.Agents.csproj" />
    <ProjectReference Include="..\Modules\Business\Application\AiGrowthPlatform.Business.Application.csproj" />
    <ProjectReference Include="..\Modules\Business\Infrastructure\AiGrowthPlatform.Business.Infrastructure.csproj" />
  </ItemGroup>

</Project>
